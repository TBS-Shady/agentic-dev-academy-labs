# Normalize line endings: LF in the repo and on checkout, so shell scripts,
# Terraform and YAML behave the same on Windows, macOS, Linux and CI.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.ps1  text eol=crlf
*.psm1 text eol=crlf
*.psd1 text eol=crlf
*.bat  text eol=crlf
*.cmd  text eol=crlf

# Binary files: never convert.
*.png  binary
*.jpg  binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.zip  binary
*.pfx  binary
*.p12  binary
